{
  "name": "tw-animations-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Monorepo for Tailwind CSS Animate packages",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build:packages": "echo 'CSS packages don't need build'",
    "build:web": "pnpm --filter web build",
    "build": "pnpm run build:web",
    "test": "pnpm --filter './packages/*' test",
    "test:v4": "pnpm --filter tw-animations test",
    "test:v3": "pnpm --filter tw-animations-plugin test",
    "publish:packages": "pnpm --filter './packages/*' publish --access public"
  },
  "devDependencies": {
    "jest": "^30.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
