---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BackgroundPattern from "../components/BackgroundPattern.astro";
import InstallTabs from "../components/InstallTabs.astro";
import AnimationGrid from "../components/AnimationGrid.astro";
---

<Layout>
  <BackgroundPattern />
  <Navbar />

  <!-- Hero Section (Installation) -->
  <section id="installation" class="relative overflow-hidden py-20 sm:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-(--color-primary)/20 bg-(--color-primary)/10 px-4 py-2 text-sm font-medium text-(--color-primary) animate-fade-in-up"
        >
          ✨ Now with Scroll Animations
        </div>

        <h1
          class="mb-6 text-5xl font-bold tracking-tight text-(--color-text) sm:text-6xl lg:text-7xl animate-fade-in-up animate-delay-100"
        >
          Tailwind
          <br />
          <span
            class="bg-linear-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent"
          >
            Animations
          </span>
        </h1>

        <p
          class="mx-auto mb-12 max-w-2xl text-lg text-(--color-text-muted) animate-fade-in-up animate-delay-200"
        >
          The easiest way to add stunning animations to your Tailwind CSS projects.<br />
          Zero configuration, pure performance.
        </p>

        <!-- Installation Tabs -->
        <div class="animate-fade-in-up animate-delay-300">
          <InstallTabs />
        </div>
      </div>
    </div>
  </section>

  <!-- Animation Collection -->
  <section id="animations" class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2
          class="mb-4 text-4xl font-bold text-(--color-text) animate-fade-in-up animate-delay-400"
        >
          Animation Collection
        </h2>
        <p class="text-lg text-(--color-text-muted) animate-fade-in-up animate-delay-500">
          Explore our comprehensive library of ready-to-use animations
        </p>
      </div>

      <AnimationGrid />
    </div>
  </section>

  <!-- Scroll Animations Section -->
  <section id="scroll" class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-20 text-center">
        <h2 class="mb-3 text-4xl font-bold tracking-tight text-(--color-text)">
          Scroll-driven animations
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-(--color-text-muted)">
          Use <code
            class="rounded border border-(--color-border) bg-(--color-bg-alt) px-1.5 py-0.5 font-mono text-sm text-(--color-primary)"
            >timeline-view</code
          > and <code
            class="rounded border border-(--color-border) bg-(--color-bg-alt) px-1.5 py-0.5 font-mono text-sm text-(--color-primary)"
            >animate-range</code
          > to tie animations to scroll. Each row below shows the code and the live result — scroll to
          trigger them.
        </p>
      </div>

      <!-- Demo rows: each point in a card (same style as Animation Collection) -->
      <div class="grid gap-6">
        <!-- Card 1: Zoom -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >01 — Zoom</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Scales in as the element enters the viewport.
              </p>
              <code
                class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
              >
                timeline-view animate-zoom-in animate-range-cover
              </code>
            </div>
            <div class="flex items-center justify-center">
              <div
                class="timeline-view animate-zoom-in animate-range-cover flex h-52 w-full max-w-sm items-center justify-center rounded-xl bg-linear-to-br from-(--color-primary) to-indigo-600 font-semibold text-white shadow-xl shadow-(--color-primary)/20"
              >
                Zoom on scroll
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: Range presets -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >02 — Range presets</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Control when the animation runs: gradual, moderate, brisk, or rapid.
              </p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                <code
                  class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
                >
                  animate-range-gradual
                </code>
                <code
                  class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
                >
                  animate-range-moderate
                </code>
                <code
                  class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
                >
                  animate-range-brisk
                </code>
                <code
                  class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
                >
                  animate-range-rapid
                </code>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div
                class="timeline-view animate-fade-in animate-range-gradual flex flex-col items-center justify-center gap-1 rounded-lg bg-linear-to-br from-(--color-primary)/80 to-indigo-500/80 p-4 text-center text-sm font-medium text-white"
              >
                <span>Gradual</span>
              </div>
              <div
                class="timeline-view animate-fade-in animate-range-moderate flex flex-col items-center justify-center gap-1 rounded-lg bg-linear-to-br from-indigo-500/80 to-violet-500/80 p-4 text-center text-sm font-medium text-white"
              >
                <span>Moderate</span>
              </div>
              <div
                class="timeline-view animate-fade-in animate-range-brisk flex flex-col items-center justify-center gap-1 rounded-lg bg-linear-to-br from-violet-500/80 to-purple-500/80 p-4 text-center text-sm font-medium text-white"
              >
                <span>Brisk</span>
              </div>
              <div
                class="timeline-view animate-fade-in animate-range-rapid flex flex-col items-center justify-center gap-1 rounded-lg bg-linear-to-br from-purple-500/80 to-(--color-primary)/80 p-4 text-center text-sm font-medium text-white"
              >
                <span>Rapid</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3: Slide end -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >03 — Slide from end</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Enters from the right with a custom range.
              </p>
              <code
                class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
              >
                timeline-view animate-slide-in-end animate-range-[entry_5%_contain_20%]
              </code>
            </div>
            <div class="flex items-center justify-center">
              <div
                class="timeline-view animate-slide-in-end animate-range-[entry_5%_contain_20%] flex h-40 w-full max-w-sm items-center justify-center rounded-xl bg-linear-to-r from-indigo-600 to-violet-600 font-semibold text-white shadow-xl shadow-indigo-500/20"
              >
                Slide from end
              </div>
            </div>
          </div>
        </div>

        <!-- Card 4: Slide start -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center md:order-2">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >04 — Slide from start</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">Enters from the left.</p>
              <code
                class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
              >
                timeline-view animate-slide-in-start animate-range-[entry_5%_contain_20%]
              </code>
            </div>
            <div class="flex items-center justify-center md:order-1">
              <div
                class="timeline-view animate-slide-in-start animate-range-[entry_5%_contain_20%] flex h-40 w-full max-w-sm items-center justify-center rounded-xl bg-linear-to-r from-violet-600 to-purple-600 font-semibold text-white shadow-xl shadow-violet-500/20"
              >
                Slide from start
              </div>
            </div>
          </div>
        </div>

        <!-- Card 5: Blur fade -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >05 — Blur fade</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Opacity + blur for a soft reveal.
              </p>
              <code
                class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
              >
                timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%]
              </code>
            </div>
            <div class="flex items-center justify-center">
              <div
                class="timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%] flex h-40 w-full max-w-sm items-center justify-center rounded-xl bg-linear-to-br from-(--color-primary) to-cyan-600 font-semibold text-white shadow-xl shadow-(--color-primary)/20"
              >
                Blur in
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-16 flex justify-center">
        <div
          class="inline-flex items-center gap-3 rounded-xl border border-amber-500/30 bg-amber-500/10 px-5 py-3"
        >
          <svg class="h-5 w-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium text-amber-600 dark:text-amber-400"
            >Chrome 115+, Edge 115+, Safari 17.4+</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Scroll & View Timelines — same card layout as Scroll Animations -->
  <section id="timelines" class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center">
        <h2 class="mb-3 text-4xl font-bold tracking-tight text-(--color-text)">
          Scroll & View Timelines
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-(--color-text-muted)">
          Tie animations to scroll progress or element visibility. Each card: code on the left, live
          demo on the right.
        </p>
      </div>

      <div class="grid gap-6">
        <!-- 01 — Vertical progress -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[200px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >01 — Vertical progress</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Progress bar driven by vertical scroll.
              </p>
              <code
                class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
              >
                timeline-scroll animate-expand-horizontally
              </code>
            </div>
            <div
              class="relative h-64 flex-1 overflow-y-auto rounded-xl border border-(--color-border) bg-(--color-bg-alt)"
            >
              <div
                class="timeline-scroll animate-expand-horizontally sticky top-0 z-10 h-2 w-full origin-left rounded-t-xl bg-linear-to-r from-emerald-500 to-cyan-500"
              >
              </div>
              <div class="h-[600px] p-4">
                <div class="my-4 flex flex-col gap-3">
                  <div class="h-28 rounded-lg bg-(--color-border)"></div>
                  <div class="h-28 rounded-lg bg-(--color-border)"></div>
                  <div class="h-28 rounded-lg bg-(--color-border)"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 02 — Horizontal progress -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[200px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >02 — Horizontal progress</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">Bar tied to horizontal scroll.</p>
              <code
                class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
              >
                timeline-scroll-inline animate-expand-horizontally
              </code>
            </div>

            <div
              class="h-full overflow-x-auto overflow-y-hidden rounded-xl border border-(--color-border) bg-(--color-bg-alt)"
            >
              <div
                class="timeline-scroll-inline animate-expand-horizontally sticky left-0 top-0 z-10 h-2 w-full min-w-full origin-left bg-linear-to-r from-violet-500 to-pink-500"
              >
              </div>
              <div class="flex min-w-[800px] items-center gap-4 p-4">
                <div
                  class="flex size-36 shrink-0 items-center justify-center rounded-lg bg-(--color-border) text-xl"
                >
                  →
                </div>
                <div
                  class="flex size-36 shrink-0 items-center justify-center rounded-lg bg-(--color-border) text-xl"
                >
                  →
                </div>
                <div
                  class="flex size-36 shrink-0 items-center justify-center rounded-lg bg-(--color-border) text-xl"
                >
                  →
                </div>
                <div
                  class="flex size-36 shrink-0 items-center justify-center rounded-lg bg-(--color-border) text-xl"
                >
                  →
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 03 — Entry & exit -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[200px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >03 — Entry & exit</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">Animate on enter vs on leave.</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                <code
                  class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
                >
                  animate-range-entry
                </code>
                <code
                  class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
                >
                  animate-range-exit
                </code>
              </div>
            </div>

            <div
              class="h-64 flex-1 overflow-y-auto rounded-xl border border-(--color-border) bg-(--color-bg-alt)"
            >
              <div class="flex h-[750px] flex-col items-center gap-6 p-6">
                <div class="h-44"></div>
                <div
                  class="timeline-view animate-slide-in-start animate-range-entry flex w-56 items-center justify-center rounded-xl bg-linear-to-br from-(--color-primary) to-cyan-600 p-4 font-semibold text-white shadow-lg"
                >
                  Enter
                </div>
                <div class="h-24"></div>
                <div
                  class="timeline-view animate-slide-out-end animate-range-exit flex w-56 items-center justify-center rounded-xl bg-linear-to-br from-rose-600 to-pink-600 p-4 font-semibold text-white shadow-lg"
                >
                  Exit
                </div>
                <div class="h-44"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 04 — Staggered reveal -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[200px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >04 — Staggered reveal</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">Different ranges for a cascade.</p>
              <code
                class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
              >
                animate-range-[entry_0%_cover_35%] ... [entry_30%_cover_65%]
              </code>
            </div>

            <div
              class="h-64 flex-1 overflow-y-auto rounded-xl border border-(--color-border) bg-(--color-bg-alt)"
            >
              <div class="flex h-[900px] flex-col items-center gap-4 p-6">
                <div class="h-44"></div>
                <div class="grid grid-cols-2 gap-3">
                  <div
                    class="timeline-view animate-fade-in-up animate-range-[entry_0%_cover_35%] flex h-20 w-24 items-center justify-center rounded-lg bg-linear-to-br from-(--color-primary)/90 to-indigo-600 text-sm font-semibold text-white"
                  >
                    1
                  </div>
                  <div
                    class="timeline-view animate-fade-in-up animate-range-[entry_10%_cover_45%] flex h-20 w-24 items-center justify-center rounded-lg bg-linear-to-br from-indigo-600 to-violet-600 text-sm font-semibold text-white"
                  >
                    2
                  </div>
                  <div
                    class="timeline-view animate-fade-in-up animate-range-[entry_20%_cover_55%] flex h-20 w-24 items-center justify-center rounded-lg bg-linear-to-br from-violet-600 to-purple-600 text-sm font-semibold text-white"
                  >
                    3
                  </div>
                  <div
                    class="timeline-view animate-fade-in-up animate-range-[entry_30%_cover_65%] flex h-20 w-24 items-center justify-center rounded-lg bg-linear-to-br from-purple-600 to-pink-600 text-sm font-semibold text-white"
                  >
                    4
                  </div>
                </div>
                <div class="h-44"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 05 — Rotation & flip -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[200px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >05 — Rotation & flip</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Rotate or flip as the element crosses the viewport.
              </p>
              <code
                class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
              >
                timeline-view animate-rotate-360 animate-range-cover
              </code>
            </div>

            <div
              class="h-64 flex-1 overflow-y-auto rounded-xl border border-(--color-border) bg-(--color-bg-alt)"
            >
              <div class="flex h-[650px] flex-col items-center gap-8 p-6">
                <div class="h-44"></div>
                <div class="flex gap-6">
                  <div
                    class="timeline-view animate-rotate-360 animate-range-cover h-16 w-16 rounded-xl bg-linear-to-br from-(--color-primary) to-indigo-600 shadow-lg"
                  >
                  </div>
                  <div
                    class="timeline-view animate-tada animate-range-cover flex h-16 w-16 items-center justify-center rounded-xl bg-linear-to-br from-violet-600 to-pink-600 text-2xl shadow-lg"
                  >
                  </div>
                </div>
                <div class="h-44"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 06 — Utilities reference (integrated) -->
        <div
          class="card-modern p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="mb-6 flex flex-col gap-1">
            <span
              class="font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
              >06 — Utilities reference</span
            >
            <p class="text-sm text-(--color-text-muted)">
              All timeline and range classes at a glance.
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-lg border border-(--color-border) bg-(--color-bg-alt) p-4">
              <h4
                class="mb-3 text-xs font-semibold uppercase tracking-wider text-(--color-primary)"
              >
                Scroll
              </h4>
              <div class="space-y-1.5">
                <code
                  class="animation-grid-code block rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
                >
                  timeline-scroll
                </code>
                <code
                  class="animation-grid-code block rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
                >
                  timeline-scroll-inline
                </code>
                <code
