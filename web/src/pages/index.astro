---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BackgroundPattern from "../components/BackgroundPattern.astro";
import InstallTabs from "../components/InstallTabs.astro";
import AnimationGrid from "../components/AnimationGrid.astro";
---

<Layout>
  <BackgroundPattern />
  <Navbar />

  <!-- Hero Section -->
  <section class="relative overflow-hidden py-20 sm:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-(--color-primary)/20 bg-(--color-primary)/10 px-4 py-2 text-sm font-medium text-(--color-primary) animate-fade-in-up"
        >
          ✨ Now with Scroll Animations
        </div>

        <h1
          class="mb-6 text-5xl font-bold tracking-tight text-(--color-text) sm:text-6xl lg:text-7xl animate-fade-in-up animate-delay-100"
        >
          Tailwind CSS
          <br />
          <span
            class="bg-linear-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent"
          >
            Animations
          </span>
        </h1>

        <p
          class="mx-auto mb-12 max-w-2xl text-lg text-(--color-text-muted) animate-fade-in-up animate-delay-200"
        >
          The easiest way to add stunning animations to your Tailwind CSS projects.<br />
          Zero configuration, pure performance.
        </p>

        <!-- Installation Tabs -->
        <div class="animate-fade-in-up animate-delay-300">
          <InstallTabs />
        </div>
      </div>
    </div>
  </section>

  <!-- Animation Collection -->
  <section id="animations" class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2
          class="mb-4 text-4xl font-bold text-(--color-text) animate-fade-in-up animate-delay-400"
        >
          Animation Collection
        </h2>
        <p class="text-lg text-(--color-text-muted) animate-fade-in-up animate-delay-500">
          Explore our comprehensive library of ready-to-use animations
        </p>
      </div>

      <AnimationGrid />
    </div>
  </section>

  <!-- Scroll Animations Section -->
  <section id="scroll" class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-20 text-center">
        <h2 class="mb-3 text-4xl font-bold tracking-tight text-(--color-text)">
          Scroll-driven animations
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-(--color-text-muted)">
          Use <code
            class="rounded border border-(--color-border) bg-(--color-bg-alt) px-1.5 py-0.5 font-mono text-sm text-(--color-primary)"
            >timeline-view</code
          > and <code
            class="rounded border border-(--color-border) bg-(--color-bg-alt) px-1.5 py-0.5 font-mono text-sm text-(--color-primary)"
            >animate-range</code
          > to tie animations to scroll. Each row below shows the code and the live result — scroll to
          trigger them.
        </p>
      </div>

      <!-- Demo rows: each point in a card (same style as Animation Collection) -->
      <div class="grid gap-6">
        <!-- Card 1: Zoom -->
        <div
          class="rounded-xl border border-(--color-border) bg-(--color-bg) p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >01 — Zoom</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Scales in as the element enters the viewport.
              </p>
              <div class="rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
                <Code
                  code="timeline-view animate-zoom-in animate-range-cover"
                  lang="css"
                  class="text-sm! border-0! text-start p-2"
                />
              </div>
            </div>
            <div class="flex items-center justify-center">
              <div
                class="timeline-view animate-zoom-in animate-range-cover flex h-52 w-full max-w-sm items-center justify-center rounded-xl bg-linear-to-br from-(--color-primary) to-indigo-600 font-semibold text-white shadow-xl shadow-(--color-primary)/20"
              >
                Zoom on scroll
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: Range presets -->
        <div
          class="rounded-xl border border-(--color-border) bg-(--color-bg) p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >02 — Range presets</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Control when the animation runs: gradual, moderate, brisk, or rapid.
              </p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                <div class="rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
                  <Code
                    code="animate-range-gradual"
                    lang="css"
                    class="text-sm! border-0! text-start p-2"
                  />
                </div>
                <div class="rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
                  <Code
                    code="animate-range-moderate"
                    lang="css"
                    class="text-sm! border-0! text-start p-2"
                  />
                </div>
                <div class="rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
                  <Code
                    code="animate-range-brisk"
                    lang="css"
                    class="text-sm! border-0! text-start p-2"
                  />
                </div>
                <div class="rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
                  <Code
                    code="animate-range-rapid"
                    lang="css"
                    class="text-sm! border-0! text-start p-2"
                  />
                </div>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div
                class="timeline-view animate-fade-in animate-range-gradual flex flex-col items-center justify-center gap-1 rounded-lg bg-linear-to-br from-(--color-primary)/80 to-indigo-500/80 p-4 text-center text-sm font-medium text-white"
              >
                <span>Gradual</span>
              </div>
              <div
                class="timeline-view animate-fade-in animate-range-moderate flex flex-col items-center justify-center gap-1 rounded-lg bg-linear-to-br from-indigo-500/80 to-violet-500/80 p-4 text-center text-sm font-medium text-white"
              >
                <span>Moderate</span>
              </div>
              <div
                class="timeline-view animate-fade-in animate-range-brisk flex flex-col items-center justify-center gap-1 rounded-lg bg-linear-to-br from-violet-500/80 to-purple-500/80 p-4 text-center text-sm font-medium text-white"
              >
                <span>Brisk</span>
              </div>
              <div
                class="timeline-view animate-fade-in animate-range-rapid flex flex-col items-center justify-center gap-1 rounded-lg bg-linear-to-br from-purple-500/80 to-(--color-primary)/80 p-4 text-center text-sm font-medium text-white"
              >
                <span>Rapid</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3: Slide end -->
        <div
          class="rounded-xl border border-(--color-border) bg-(--color-bg) p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >03 — Slide from end</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Enters from the right with a custom range.
              </p>
              <div class="rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
                <Code
                  code="timeline-view animate-slide-in-end animate-range-[entry_5%_contain_20%]"
                  lang="css"
                  class="text-sm! border-0! text-start p-2"
                />
              </div>
            </div>
            <div class="flex items-center justify-center">
              <div
                class="timeline-view animate-slide-in-end animate-range-[entry_5%_contain_20%] flex h-40 w-full max-w-sm items-center justify-center rounded-xl bg-linear-to-r from-indigo-600 to-violet-600 font-semibold text-white shadow-xl shadow-indigo-500/20"
              >
                Slide from end
              </div>
            </div>
          </div>
        </div>

        <!-- Card 4: Slide start -->
        <div
          class="rounded-xl border border-(--color-border) bg-(--color-bg) p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center md:order-2">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >04 — Slide from start</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">Enters from the left.</p>
              <div class="rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
                <Code
                  code="timeline-view animate-slide-in-start animate-range-[entry_5%_contain_20%]"
                  lang="css"
                  class="text-sm! border-0! text-start p-2"
                />
              </div>
            </div>
            <div class="flex items-center justify-center md:order-1">
              <div
                class="timeline-view animate-slide-in-start animate-range-[entry_5%_contain_20%] flex h-40 w-full max-w-sm items-center justify-center rounded-xl bg-linear-to-r from-violet-600 to-purple-600 font-semibold text-white shadow-xl shadow-violet-500/20"
              >
                Slide from start
              </div>
            </div>
          </div>
        </div>

        <!-- Card 5: Blur fade -->
        <div
          class="rounded-xl border border-(--color-border) bg-(--color-bg) p-6 transition-all hover:border-(--color-primary) hover:shadow-xl md:p-8"
        >
          <div class="grid min-h-[240px] grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-12">
            <div class="flex flex-col justify-center">
              <span
                class="mb-2 font-mono text-xs font-medium uppercase tracking-wider text-(--color-primary)"
                >05 — Blur fade</span
              >
              <p class="mb-4 text-sm text-(--color-text-muted)">
                Opacity + blur for a soft reveal.
              </p>
              <div class="rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
                <Code
                  code="timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%]"
                  lang="css"
                  class="text-sm! border-0! text-start p-2"
                />
              </div>
            </div>
            <div class="flex items-center justify-center">
              <div
                class="timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%] flex h-40 w-full max-w-sm items-center justify-center rounded-xl bg-linear-to-br from-(--color-primary) to-cyan-600 font-semibold text-white shadow-xl shadow-(--color-primary)/20"
              >
                Blur in
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-16 flex justify-center">
        <div
          class="inline-flex items-center gap-3 rounded-xl border border-amber-500/30 bg-amber-500/10 px-5 py-3"
        >
          <svg class="h-5 w-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium text-amber-600 dark:text-amber-400"
            >Chrome 115+, Edge 115+, Safari 17.4+</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Scroll & View Timelines (inspired by midudev/tailwind-animations) -->
  <section id="timelines" class="py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center">
        <h2 class="mb-3 text-4xl font-bold tracking-tight text-(--color-text)">
          Scroll & View Timelines
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-(--color-text-muted)">
          Link animations to scroll progress or element visibility with
          <code
            class="rounded border border-(--color-border) bg-(--color-bg-alt) px-1.5 py-0.5 font-mono text-sm text-(--color-primary)"
            >timeline-scroll</code
          >
          and
          <code
            class="rounded border border-(--color-border) bg-(--color-bg-alt) px-1.5 py-0.5 font-mono text-sm text-(--color-primary)"
            >timeline-view</code
          >.
        </p>
      </div>

      <div class="space-y-20">
        <!-- 1. Vertical Scroll Progress -->
        <div class="rounded-2xl border border-(--color-border) bg-(--color-bg) p-6 md:p-8">
          <h3 class="mb-2 text-lg font-semibold text-(--color-text)">Vertical scroll progress</h3>
          <p class="mb-4 text-sm text-(--color-text-muted)">
            <code class="text-(--color-primary)">timeline-scroll</code> ties the animation to the scroll container. The bar fills as you scroll.
          </p>
          <div class="h-64 overflow-y-auto rounded-xl border border-(--color-border) bg-(--color-bg-alt)">
            <div
              class="timeline-scroll animate-expand-horizontally sticky top-0 z-10 h-2 w-full origin-left rounded-t-xl bg-linear-to-r from-emerald-500 to-cyan-500"
            ></div>
            <div class="h-[700px] p-6">
              <p class="text-sm text-(--color-text-muted)">↓ Scroll down to see the progress bar fill</p>
              <div class="mt-6 flex flex-col gap-4">
                <div class="h-24 rounded-lg bg-(--color-border)"></div>
                <div class="h-24 rounded-lg bg-(--color-border)"></div>
                <div class="h-24 rounded-lg bg-(--color-border)"></div>
              </div>
            </div>
          </div>
          <div class="mt-4 rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
            <Code code="timeline-scroll animate-expand-horizontally" lang="css" class="text-sm! border-0! text-start p-2" />
          </div>
        </div>

        <!-- 2. Horizontal Scroll Progress -->
        <div class="rounded-2xl border border-(--color-border) bg-(--color-bg) p-6 md:p-8">
          <h3 class="mb-2 text-lg font-semibold text-(--color-text)">Horizontal scroll progress</h3>
          <p class="mb-4 text-sm text-(--color-text-muted)">
            <code class="text-(--color-primary)">timeline-scroll-inline</code> for horizontal containers.
          </p>
          <div class="h-44 overflow-x-auto overflow-y-hidden rounded-xl border border-(--color-border) bg-(--color-bg-alt)">
            <div
              class="timeline-scroll-inline animate-expand-horizontally sticky left-0 top-0 z-10 h-2 w-full min-w-full origin-left bg-linear-to-r from-violet-500 to-pink-500"
            ></div>
            <div class="flex h-full min-w-[1200px] items-center gap-4 p-6">
              <div class="flex h-24 w-28 shrink-0 items-center justify-center rounded-xl bg-(--color-border) text-2xl">🚀</div>
              <div class="flex h-24 w-28 shrink-0 items-center justify-center rounded-xl bg-(--color-border) text-2xl">⭐</div>
              <div class="flex h-24 w-28 shrink-0 items-center justify-center rounded-xl bg-(--color-border) text-2xl">💎</div>
              <div class="flex h-24 w-28 shrink-0 items-center justify-center rounded-xl bg-(--color-border) text-2xl">🔥</div>
              <div class="flex h-24 w-28 shrink-0 items-center justify-center rounded-xl bg-(--color-border) text-2xl">✨</div>
            </div>
          </div>
          <div class="mt-4 rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
            <Code code="timeline-scroll-inline animate-expand-horizontally" lang="css" class="text-sm! border-0! text-start p-2" />
          </div>
        </div>

        <!-- 3. Entry vs Exit Ranges -->
        <div class="rounded-2xl border border-(--color-border) bg-(--color-bg) p-6 md:p-8">
          <h3 class="mb-2 text-lg font-semibold text-(--color-text)">Entry & exit ranges</h3>
          <p class="mb-4 text-sm text-(--color-text-muted)">
            <code class="text-(--color-primary)">animate-range-entry</code> (entering) and
            <code class="text-(--color-primary)">animate-range-exit</code> (leaving).
          </p>
          <div class="h-80 overflow-y-auto rounded-xl border border-(--color-border) bg-(--color-bg-alt)">
            <div class="flex h-[900px] flex-col items-center gap-8 p-8">
              <p class="text-sm text-(--color-text-muted)">↓ Scroll to see entry/exit</p>
              <div class="h-48"></div>
              <div
                class="timeline-view animate-slide-in-start animate-range-entry flex w-64 items-center justify-center rounded-xl bg-linear-to-r from-cyan-600 to-blue-600 p-6 font-semibold text-white shadow-lg"
              >
                <span class="text-center">Entry<br /><span class="text-xs font-normal opacity-90">Plays when entering</span></span>
              </div>
              <div class="h-32"></div>
              <div
                class="timeline-view animate-slide-out-end animate-range-exit flex w-64 items-center justify-center rounded-xl bg-linear-to-r from-rose-600 to-pink-600 p-6 font-semibold text-white shadow-lg"
              >
                <span class="text-center">Exit<br /><span class="text-xs font-normal opacity-90">Plays when leaving</span></span>
              </div>
              <div class="h-48"></div>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <code class="rounded-md bg-[#0a0a0a] px-3 py-2 text-sm text-cyan-400">animate-range-entry</code>
            <code class="rounded-md bg-[#0a0a0a] px-3 py-2 text-sm text-rose-400">animate-range-exit</code>
          </div>
        </div>

        <!-- 4. Staggered Reveal -->
        <div class="rounded-2xl border border-(--color-border) bg-(--color-bg) p-6 md:p-8">
          <h3 class="mb-2 text-lg font-semibold text-(--color-text)">Staggered reveal</h3>
          <p class="mb-4 text-sm text-(--color-text-muted)">
            Different <code class="text-(--color-primary)">animate-range</code> values for a staggered effect.
          </p>
          <div class="h-96 overflow-y-auto rounded-xl border border-(--color-border) bg-(--color-bg-alt)">
            <div class="flex h-[1000px] flex-col items-center gap-6 p-8">
              <p class="text-sm text-(--color-text-muted)">↓ Scroll to reveal in sequence</p>
              <div class="h-64"></div>
              <div class="grid grid-cols-2 gap-4">
                <div
                  class="timeline-view animate-fade-in-up animate-range-[entry_0%_cover_35%] flex h-24 w-28 items-center justify-center rounded-xl bg-amber-600 font-semibold text-white shadow-lg"
                >
                  First
                </div>
                <div
                  class="timeline-view animate-fade-in-up animate-range-[entry_10%_cover_45%] flex h-24 w-28 items-center justify-center rounded-xl bg-orange-600 font-semibold text-white shadow-lg"
                >
                  Second
                </div>
                <div
                  class="timeline-view animate-fade-in-up animate-range-[entry_20%_cover_55%] flex h-24 w-28 items-center justify-center rounded-xl bg-red-600 font-semibold text-white shadow-lg"
                >
                  Third
                </div>
                <div
                  class="timeline-view animate-fade-in-up animate-range-[entry_30%_cover_65%] flex h-24 w-28 items-center justify-center rounded-xl bg-pink-600 font-semibold text-white shadow-lg"
                >
                  Fourth
                </div>
              </div>
              <div class="h-80"></div>
            </div>
          </div>
          <div class="mt-4 rounded-lg border border-[#1f2937] bg-[#0d1117] overflow-hidden">
            <Code code="animate-range-[entry_0%_cover_35%] → [entry_10%_cover_45%] → ..." lang="css" class="text-sm! border-0! text-start p-2" />
          </div>
        </div>

        <!-- 5. Rotation on scroll -->
        <div class="rounded-2xl border border-(--color-border) bg-(--color-bg) p-6 md:p-8">
          <h3 class="mb-2 text-lg font-semibold text-(--color-text)">Rotation on scroll</h3>
          <p class="mb-4 text-sm text-(--color-text-muted)">
            <code class="text-(--color-primary)">animate-rotate-360</code> and
            <code class="text-(--color-primary)">animate-flip-in-x</code> with
            <code class="text-(--color-primary)">animate-range-cover</code>.
          </p>
          <div class="h-72 overflow-y-auto rounded-xl border border-(--color-border) bg-(--color-bg-alt)">
            <div class="flex h-[750px] flex-col items-center gap-8 p-8">
              <p class="text-sm text-(--color-text-muted)">↓ Scroll to spin</p>
              <div class="h-40"></div>
              <div class="flex gap-6">
                <div
                  class="timeline-view animate-rotate-360 animate-range-cover h-20 w-20 rounded-xl bg-linear-to-br from-indigo-600 to-violet-600 shadow-lg"
                ></div>
                <div
                  class="timeline-view animate-flip-in-x animate-range-cover flex h-20 w-20 items-center justify-center rounded-xl bg-linear-to-br from-fuchsia-600 to-pink-600 text-3xl shadow-lg"
                >
                  🎲
                </div>
              </div>
              <div class="h-80"></div>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <code class="rounded-md bg-[#0a0a0a] px-3 py-2 text-sm text-indigo-400">animate-rotate-360</code>
            <code class="rounded-md bg-[#0a0a0a] px-3 py-2 text-sm text-fuchsia-400">animate-flip-in-x</code>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Utilities Reference -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-4xl font-bold text-(--color-text)">Timeline Utilities Reference</h2>
        <p class="text-lg text-(--color-text-muted)">
          Available timeline utilities and how to use them
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Scroll Timelines -->
        <div class="rounded-xl border border-(--color-border) p-6">
          <h3 class="mb-4 text-xl font-bold text-(--color-text)">Scroll Timelines</h3>
          <div class="space-y-2 text-sm">
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >timeline-scroll</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >timeline-[scroll(x)]</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >timeline-[scroll(y)]</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >timeline-[scroll(block)]</code
            >
          </div>
        </div>

        <!-- View Timelines -->
        <div class="rounded-xl border border-(--color-border) p-6">
          <h3 class="mb-4 text-xl font-bold text-(--color-text)">View Timelines</h3>
          <div class="space-y-2 text-sm">
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >timeline-view</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >timeline-[view(x)]</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >timeline-[view(y)]</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >timeline-[view(block)]</code
            >
          </div>
        </div>

        <!-- Animation Ranges -->
        <div class="rounded-xl border border-(--color-border) p-6">
          <h3 class="mb-4 text-xl font-bold text-(--color-text)">Animation Ranges</h3>
          <div class="space-y-2 text-sm">
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >animate-range-cover</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >animate-range-entry</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >animate-range-exit</code
            >
          </div>
        </div>

        <!-- Preset Ranges -->
        <div class="rounded-xl border border-(--color-border) p-6">
          <h3 class="mb-4 text-xl font-bold text-(--color-text)">Preset Ranges</h3>
          <div class="space-y-2 text-sm">
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >animate-range-gradual (10%-90%)</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >animate-range-moderate (20%-80%)</code
            >
            <code class="block rounded-md bg-[#0a0a0a] px-3 py-2 text-(--color-text)"
              >animate-range-brisk (30%-70%)</code
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="mb-6 text-4xl font-bold text-(--color-text)">Ready to get started?</h2>
      <p class="mb-8 text-lg text-(--color-text-muted)">
        Join developers who are creating beautiful animations with Tailwind CSS
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/configurator"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-(--color-primary) px-8 py-4 text-lg font-semibold text-white transition-all hover:bg-(--color-primary-hover) hover:scale-105"
        >
          Try Interactive Configurator
        </a>
        <a
          href="https://github.com/iscodex/tailwindcss-animate"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-(--color-border) px-8 py-4 text-lg font-semibold text-(--color-text) transition-all hover:border-(--color-primary) hover:scale-105"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
