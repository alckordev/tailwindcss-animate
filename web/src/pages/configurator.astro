---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BackgroundPattern from "../components/BackgroundPattern.astro";
import ConfiguratorWidget from "../components/Configurator.astro";
---

<Layout
  title="Configurator - Tailwind CSS Animate"
  description="Configure and preview Tailwind CSS animations in real-time. Customize duration, delay, timing and more."
>
  <BackgroundPattern />
  <Navbar />

  <main class="min-h-screen py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-12 text-center">
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-(--color-primary)/20 bg-(--color-primary)/10 px-4 py-2 text-sm font-medium text-(--color-primary)"
        >
          🎨 Interactive Tool
        </div>
        <h1 class="mb-4 text-4xl font-bold text-(--color-text) sm:text-5xl">
          Animation Configurator
        </h1>
        <p class="text-lg text-(--color-text-muted)">
          Customize and preview animations in real-time
        </p>
      </div>

      <!-- Configurator -->
      <ConfiguratorWidget />

      <!-- Usage Guide -->
      <section class="card-modern mt-16" aria-labelledby="usage-guide-title">
        <header class="mb-10">
          <p class="label-modern mb-2">Documentation</p>
          <h2 id="usage-guide-title" class="text-2xl font-bold text-(--color-text) sm:text-3xl">
            Usage Guide
          </h2>
          <p class="mt-2 max-w-2xl text-sm text-(--color-text-muted)">
            How to get the most out of the configurator: basic playback, scroll-driven animations,
            and custom values.
          </p>
        </header>

        <div class="grid gap-8 md:grid-cols-2">
          <article class="rounded-xl border border-(--color-border) bg-(--color-bg-alt)/50 p-6">
            <div class="mb-4 flex items-center gap-3">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-(--color-primary)/15 text-(--color-primary)"
                aria-hidden="true"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                  ></path><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
                >
              </span>
              <h3 class="text-lg font-semibold text-(--color-text)">Basic Animations</h3>
            </div>
            <ol class="usage-guide-steps space-y-3 text-sm text-(--color-text-muted)">
              <li>Select an animation from the dropdown</li>
              <li>Adjust duration and delay if needed</li>
              <li>Copy the generated class and paste it into your markup</li>
            </ol>
          </article>

          <article class="rounded-xl border border-(--color-border) bg-(--color-bg-alt)/50 p-6">
            <div class="mb-4 flex items-center gap-3">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-violet-500/15 text-violet-400"
                aria-hidden="true"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4"
                  ></path><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17 8v12m0 0l4-4m-4 4l-4-4"></path></svg
                >
              </span>
              <h3 class="text-lg font-semibold text-(--color-text)">Scroll timeline</h3>
            </div>
            <ol class="usage-guide-steps space-y-3 text-sm text-(--color-text-muted)">
              <li>
                Enable <strong class="text-(--color-text)">Scroll timeline</strong> and pick a range (e.g.
                gradual, rapid)
              </li>
              <li>Scroll inside the preview to see the animation run with scroll progress</li>
              <li>
                Copy the <code
                  class="rounded border border-(--color-border) bg-(--color-bg) px-1.5 py-0.5 font-mono text-xs text-(--color-primary)"
                  >timeline-view</code
                > classes
              </li>
            </ol>
            <div
              class="mt-4 inline-flex items-center gap-3 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-2"
            >
              <svg
                class="h-5 w-5 text-amber-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-sm font-medium text-amber-600 dark:text-amber-400"
                >Chrome 115+, Edge 115+, Safari 17.4+</span
              >
            </div>
          </article>
        </div>

        <div class="mt-8 rounded-xl border border-(--color-border) bg-(--color-bg-alt)/30 p-6">
          <div class="mb-3 flex items-center gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-(--color-border) text-(--color-text-muted)"
              aria-hidden="true"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg
              >
            </span>
            <h3 class="text-lg font-semibold text-(--color-text)">Arbitrary values</h3>
          </div>
          <p class="mb-4 text-sm text-(--color-text-muted)">
            Use bracket notation for custom duration or delay in your project:
          </p>
          <code
            class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
          >
            animate-duration-[2.5s] animate-delay-300
          </code>
        </div>
      </section>

      <!-- Examples -->
      <section class="mt-16" aria-labelledby="examples-title">
        <header class="mb-10 text-center">
          <p class="label-modern mb-2">Reference</p>
          <h2 id="examples-title" class="text-2xl font-bold text-(--color-text) sm:text-3xl">
            Usage Examples
          </h2>
          <p class="mx-auto mt-2 max-w-xl text-sm text-(--color-text-muted)">
            Copy-paste patterns for common use cases.
          </p>
        </header>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          <article
            class="card-modern text-center p-6 transition-all hover:border-(--color-primary) hover:shadow-xl"
          >
            <h3 class="mb-1 font-semibold text-(--color-text)">Button hover</h3>
            <p class="mb-4 text-xs text-(--color-text-muted)">Pulse on hover</p>
            <div
              class="examples-preview mb-4 flex min-h-[80px] shrink-0 items-center justify-center"
            >
              <button
                class="rounded-lg bg-blue-500 px-4 py-2 font-semibold text-white transition-all hover:animate-pulse"
              >
                Hover Me
              </button>
            </div>
            <code
              class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
            >
              hover:animate-pulse
            </code>
          </article>

          <article
            class="card-modern text-center p-6 transition-all hover:border-(--color-primary) hover:shadow-xl"
          >
            <h3 class="mb-1 font-semibold text-(--color-text)">Loading spinner</h3>
            <p class="mb-4 text-xs text-(--color-text-muted)">Continuous rotation</p>
            <div
              class="examples-preview mb-4 flex min-h-[80px] shrink-0 items-center justify-center"
            >
              <div
                class="h-12 w-12 rounded-full border-4 border-purple-500 border-t-transparent animate-spin"
                aria-hidden="true"
              >
              </div>
            </div>
            <code
              class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
            >
              animate-spin
            </code>
          </article>

          <article
            class="card-modern text-center p-6 transition-all hover:border-(--color-primary) hover:shadow-xl"
          >
            <h3 class="mb-1 font-semibold text-(--color-text)">Alert badge</h3>
            <p class="mb-4 text-xs text-(--color-text-muted)">Bounce for attention</p>
            <div
              class="examples-preview mb-4 flex min-h-[80px] shrink-0 items-center justify-center"
            >
              <span
                class="rounded-full bg-red-500 px-6 py-2 font-semibold text-white animate-bounce"
              >
                New!
              </span>
            </div>
            <code
              class="animation-grid-code rounded-lg border border-(--color-border) bg-[#0c0c0f] px-3 py-2 text-left font-mono text-xs text-[#a5b4fc]"
            >
              animate-bounce
            </code>
          </article>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .usage-guide-steps {
    list-style: decimal;
    padding-left: 1.25rem;
  }
  .usage-guide-steps li {
    padding-left: 0.25rem;
  }
</style>
