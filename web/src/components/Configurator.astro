---
import { animations } from "../data/animations";

const categories = Array.from(new Set(animations.map((a) => a.category)));
const rangePresets = [
  { value: "cover", label: "cover" },
  { value: "contain", label: "contain" },
  { value: "entry", label: "entry" },
  { value: "exit", label: "exit" },
  { value: "gradual", label: "gradual" },
  { value: "moderate", label: "moderate" },
  { value: "brisk", label: "brisk" },
  { value: "rapid", label: "rapid" },
];
const durationOptions = [
  { value: "", label: "Default" },
  { value: "animate-duration-150", label: "150ms" },
  { value: "animate-duration-300", label: "300ms" },
  { value: "animate-duration-500", label: "500ms" },
  { value: "animate-duration-1000", label: "1000ms" },
  { value: "animate-duration-[1.5s]", label: "1.5s" },
  { value: "animate-duration-2000", label: "2000ms" },
  { value: "animate-duration-3000", label: "3000ms" },
];
const delayOptions = [
  { value: "", label: "None" },
  { value: "animate-delay-100", label: "100ms" },
  { value: "animate-delay-200", label: "200ms" },
  { value: "animate-delay-300", label: "300ms" },
  { value: "animate-delay-500", label: "500ms" },
  { value: "animate-delay-1000", label: "1s" },
];
---

<div id="configurator" class="configurator-modern card-modern">
  <div class="configurator-grid">
    <!-- Controls -->
    <div class="configurator-controls">
      <div class="configurator-field">
        <label for="config-animation" class="label-modern">Animation</label>
        <select id="config-animation" class="select-modern">
          {
            categories.map((cat) => (
              <optgroup label={cat}>
                {animations
                  .filter((a) => a.category === cat)
                  .map((a) => (
                    <option value={a.class}>{a.name}</option>
                  ))}
              </optgroup>
            ))
          }
        </select>
      </div>

      <div class="configurator-row">
        <div class="configurator-field">
          <label for="config-duration" class="label-modern">Duration</label>
          <select id="config-duration" class="select-modern">
            {durationOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
        <div class="configurator-field">
          <label for="config-delay" class="label-modern">Delay</label>
          <select id="config-delay" class="select-modern">
            {delayOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
      </div>

      <div class="configurator-toggles">
        <label class="configurator-switch-wrap">
          <input type="checkbox" id="config-scroll" class="configurator-switch-input" />
          <span class="configurator-switch">Scroll timeline</span>
        </label>
        <div id="config-range-wrap" class="configurator-range-wrap hidden flex-1">
          <select id="config-range" class="select-modern select-modern-sm">
            {rangePresets.map((r) => <option value={r.value}>{r.label}</option>)}
          </select>
        </div>
      </div>
    </div>

    <!-- Preview stage -->
    <div class="configurator-preview-wrap">
      <div id="config-preview" class="configurator-stage">
        <span class="configurator-preview-title">Preview</span>
        <button type="button" id="config-replay" class="configurator-replay hidden">
          Replay
        </button>
        <div id="config-preview-box" class="configurator-stage-box animate-fade-in">Box</div>
      </div>
    </div>
  </div>

  <!-- Output (terminal style) -->
  <div class="configurator-output">
    <div class="configurator-output-header">
      <span class="configurator-output-dots">
        <span></span><span></span><span></span>
      </span>
      <span class="configurator-output-title">class</span>
      <button type="button" id="config-copy" class="configurator-copy">
        <svg
          class="configurator-copy-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path
            d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg
        >
        <span class="configurator-copy-text">Copy</span>
      </button>
    </div>
    <div class="configurator-output-body">
      <code id="config-code">animate-fade-in</code>
    </div>
  </div>
</div>

<style>
  .configurator-modern {
    --cfg-bg: rgba(0, 0, 0, 0.6);
    --cfg-border: rgba(255, 255, 255, 0.06);
    --cfg-surface: rgba(255, 255, 255, 0.03);
    --cfg-text: #f9fafb;
    --cfg-muted: #9ca3af;
    --cfg-primary: #2563eb;
    --cfg-stage: radial-gradient(
      ellipse 80% 60% at 50% 50%,
      rgba(37, 99, 235, 0.08),
      transparent 60%
    );
  }

  .configurator-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .configurator-grid {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .configurator-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .configurator-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .configurator-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .configurator-toggles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .configurator-range-wrap.hidden {
    display: none !important;
  }

  /* Switch */
  .configurator-switch-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    user-select: none;
  }
  .configurator-switch-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
  .configurator-switch-input:focus-visible + .configurator-switch {
    box-shadow: 0 0 0 2px var(--cfg-primary);
  }
  .configurator-switch {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--cfg-muted);
    background: var(--cfg-surface);
    border: 1px solid var(--cfg-border);
    border-radius: 0.375rem;
    box-sizing: border-box;
    transition:
      color 0.2s,
      background 0.2s,
      border-color 0.2s;
  }
  .configurator-switch-wrap:has(.configurator-switch-input:checked) .configurator-switch {
    color: var(--cfg-primary);
    background: rgba(37, 99, 235, 0.15);
    border-color: rgba(37, 99, 235, 0.4);
  }

  /* Preview stage */
  .configurator-preview-wrap {
    display: flex;
    flex-direction: column;
  }
  .configurator-stage {
    position: relative;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: var(--cfg-stage);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 1.5rem;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }
  .configurator-preview-title {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cfg-muted);
    pointer-events: none;
  }
  .configurator-replay {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    color: var(--cfg-muted);
    background: var(--cfg-surface);
    border: 1px solid var(--cfg-border);
    border-radius: 0.375rem;
    padding: 0 0.625rem;
    transition:
      color 0.2s,
      background 0.2s,
      border-color 0.2s;
  }
  .configurator-replay:hover {
    color: var(--cfg-text);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .configurator-replay.hidden {
    display: none !important;
  }
  .configurator-stage-box {
    height: 5rem;
    width: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    background: linear-gradient(135deg, var(--cfg-primary), #4f46e5);
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.35);
  }

  /* Output (terminal) */
  .configurator-output {
    margin-top: 1.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--cfg-border);
    background: #0c0c0f;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .configurator-output-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--cfg-border);
  }
  .configurator-output-header .configurator-copy {
    margin-left: auto;
    margin-top: 0;
    margin-bottom: 0;
  }
  .configurator-output-dots {
    display: flex;
    gap: 0.375rem;
  }
  .configurator-output-dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }
  .configurator-output-dots span:nth-child(1) {
    background: #ef4444;
  }
  .configurator-output-dots span:nth-child(2) {
    background: #eab308;
  }
  .configurator-output-dots span:nth-child(3) {
    background: #22c55e;
  }
  .configurator-output-title {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--cfg-muted);
  }
  .configurator-output-body {
    padding: 1rem 1.25rem;
    font-family: ui-monospace, monospace;
    font-size: 0.8125rem;
    color: #a5b4fc;
    word-break: break-all;
  }
  .configurator-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--cfg-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--cfg-border);
    border-radius: 0.375rem;
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .configurator-copy:hover {
    color: var(--cfg-text);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .configurator-copy:active {
    transform: scale(0.98);
  }
  .configurator-copy-icon {
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
  }
</style>

<script>
  (function () {
    const root = document.getElementById("configurator");
    if (!root) return;

    const selectAnimation = root.querySelector<HTMLSelectElement>("#config-animation");
    const selectDuration = root.querySelector<HTMLSelectElement>("#config-duration");
    const selectDelay = root.querySelector<HTMLSelectElement>("#config-delay");
    const checkboxScroll = root.querySelector<HTMLInputElement>("#config-scroll");
    const rangeWrap = root.querySelector<HTMLElement>("#config-range-wrap");
    const selectRange = root.querySelector<HTMLSelectElement>("#config-range");
    const previewBox = root.querySelector<HTMLElement>("#config-preview-box");
    const codeEl = root.querySelector<HTMLElement>("#config-code");
    const btnCopy = root.querySelector<HTMLButtonElement>("#config-copy");
    const btnReplay = root.querySelector<HTMLButtonElement>("#config-replay");

    if (
      !selectAnimation ||
      !selectDuration ||
      !selectDelay ||
      !checkboxScroll ||
      !rangeWrap ||
      !selectRange ||
      !previewBox ||
      !codeEl ||
      !btnCopy ||
      !btnReplay
    ) {
      return;
    }

    const baseBoxClasses = "configurator-stage-box";

    function getRangeClass(value: string) {
      return value ? `animate-range-${value}` : "";
    }

    function buildClasses() {
      const anim = selectAnimation?.value ?? "";
      const duration = selectDuration?.value ?? "";
      const delay = selectDelay?.value ?? "";
      const useScroll = checkboxScroll?.checked ?? false;
      const range = selectRange?.value ?? "";

      const parts = [anim];
      if (duration) parts.push(duration);
      if (delay) parts.push(delay);
      if (useScroll) {
        parts.unshift("timeline-view");
        const rangeClass = getRangeClass(range);
        if (rangeClass) parts.push(rangeClass);
      }
      return parts.filter(Boolean).join(" ");
    }

    function updatePreview() {
      const classes = buildClasses();
      if (previewBox) {
        previewBox.className = baseBoxClasses + " " + classes;
      }
      if (codeEl) codeEl.textContent = classes;
    }

    function toggleRangeVisibility() {
      if (checkboxScroll?.checked) {
        rangeWrap?.classList.remove("hidden");
        btnReplay?.classList.add("hidden");
      } else {
        rangeWrap?.classList.add("hidden");
        btnReplay?.classList.remove("hidden");
      }
      updatePreview();
    }

    selectAnimation.addEventListener("change", updatePreview);
    selectDuration.addEventListener("change", updatePreview);
    selectDelay.addEventListener("change", updatePreview);
    selectRange.addEventListener("change", updatePreview);
    checkboxScroll.addEventListener("change", toggleRangeVisibility);

    btnReplay.addEventListener("click", () => {
      const box = root.querySelector<HTMLElement>("#config-preview-box");
      if (!box) return;
      const fullClasses = baseBoxClasses + " " + buildClasses();
      box.className = baseBoxClasses;
      void box.offsetHeight;
      box.className = fullClasses;
    });

    const copyTextSpan = btnCopy.querySelector<HTMLElement>(".configurator-copy-text");
    btnCopy.addEventListener("click", () => {
      const text = buildClasses();
      navigator.clipboard.writeText(text).then(() => {
        if (copyTextSpan) {
          const orig = copyTextSpan.textContent;
          copyTextSpan.textContent = "Copied!";
          setTimeout(() => {
            copyTextSpan.textContent = orig ?? "Copy";
          }, 2000);
        }
      });
    });

    toggleRangeVisibility();
  })();
</script>
