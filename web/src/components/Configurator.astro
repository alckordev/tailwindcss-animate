---
import { animations } from "../data/animations";

const categories = Array.from(new Set(animations.map((a) => a.category)));
const rangePresets = [
  { value: "cover", label: "cover" },
  { value: "contain", label: "contain" },
  { value: "entry", label: "entry" },
  { value: "exit", label: "exit" },
  { value: "gradual", label: "gradual (10%–90%)" },
  { value: "moderate", label: "moderate (20%–80%)" },
  { value: "brisk", label: "brisk (30%–70%)" },
  { value: "rapid", label: "rapid (40%–60%)" },
];
const durationOptions = [
  { value: "", label: "Default" },
  { value: "animate-duration-150", label: "animate-duration-150" },
  { value: "animate-duration-300", label: "animate-duration-300" },
  { value: "animate-duration-500", label: "animate-duration-500" },
  { value: "animate-duration-1000", label: "animate-duration-1000" },
  { value: "animate-duration-[1.5s]", label: "animate-duration-[1.5s]" },
  { value: "animate-duration-2000", label: "animate-duration-2000" },
  { value: "animate-duration-3000", label: "animate-duration-3000" },
];
const delayOptions = [
  { value: "", label: "None" },
  { value: "animate-delay-100", label: "animate-delay-100" },
  { value: "animate-delay-200", label: "animate-delay-200" },
  { value: "animate-delay-300", label: "animate-delay-300" },
  { value: "animate-delay-500", label: "animate-delay-500" },
  { value: "animate-delay-1000", label: "animate-delay-1000" },
];
---

<div
  id="configurator"
  class="rounded-2xl border border-(--color-border) bg-(--color-bg) p-6 shadow-xl md:p-8"
>
  <div class="grid gap-8 lg:grid-cols-2">
    <!-- Controls -->
    <div class="space-y-6">
      <div>
        <label for="config-animation" class="mb-2 block text-sm font-medium text-(--color-text)">
          Animation
        </label>
        <select
          id="config-animation"
          class="w-full rounded-lg border border-(--color-border) bg-(--color-bg-alt) px-4 py-2.5 text-(--color-text) focus:border-(--color-primary) focus:outline-none focus:ring-2 focus:ring-(--color-primary)/20"
        >
          {
            categories.map((cat) => (
              <optgroup label={cat}>
                {animations
                  .filter((a) => a.category === cat)
                  .map((a) => (
                    <option value={a.class}>{a.name}</option>
                  ))}
              </optgroup>
            ))
          }
        </select>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="config-duration" class="mb-2 block text-sm font-medium text-(--color-text)">
            Duration
          </label>
          <select
            id="config-duration"
            class="w-full rounded-lg border border-(--color-border) bg-(--color-bg-alt) px-4 py-2.5 text-(--color-text) focus:border-(--color-primary) focus:outline-none focus:ring-2 focus:ring-(--color-primary)/20"
          >
            {durationOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
        <div>
          <label for="config-delay" class="mb-2 block text-sm font-medium text-(--color-text)">
            Delay
          </label>
          <select
            id="config-delay"
            class="w-full rounded-lg border border-(--color-border) bg-(--color-bg-alt) px-4 py-2.5 text-(--color-text) focus:border-(--color-primary) focus:outline-none focus:ring-2 focus:ring-(--color-primary)/20"
          >
            {delayOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <label class="flex cursor-pointer items-center gap-2">
          <input
            type="checkbox"
            id="config-scroll"
            class="h-4 w-4 rounded border-(--color-border) text-(--color-primary) focus:ring-(--color-primary)"
          />
          <span class="text-sm font-medium text-(--color-text)">Use scroll timeline</span>
        </label>
        <div id="config-range-wrap" class="hidden">
          <label for="config-range" class="mr-2 text-sm font-medium text-(--color-text)"
            >Range</label
          >
          <select
            id="config-range"
            class="rounded-lg border border-(--color-border) bg-(--color-bg-alt) px-3 py-2 text-sm text-(--color-text) focus:border-(--color-primary) focus:outline-none focus:ring-2 focus:ring-(--color-primary)/20"
          >
            {rangePresets.map((r) => <option value={r.value}>{r.label}</option>)}
          </select>
        </div>
      </div>
    </div>

    <!-- Preview (donde estaba Generated classes) -->
    <div class="flex flex-col">
      <div class="mb-2 flex items-center justify-between">
        <span class="text-sm font-medium text-(--color-text)">Preview</span>
        <button
          type="button"
          id="config-replay"
          class="rounded-md border border-(--color-border) bg-(--color-bg-alt) px-3 py-1.5 text-xs font-medium text-(--color-text) hover:bg-(--color-border)/50 hidden"
        >
          Replay
        </button>
      </div>
      <div
        id="config-preview"
        class="flex min-h-[200px] flex-1 items-center justify-center rounded-xl border border-(--color-border) bg-(--color-bg-alt)/50 p-6"
      >
        <div
          id="config-preview-box"
          class="h-24 w-24 rounded-xl bg-linear-to-br from-(--color-primary) to-indigo-600 font-semibold text-white shadow-lg flex items-center justify-center text-sm animate-fade-in"
        >
          Box
        </div>
      </div>
    </div>
  </div>

  <!-- Generated classes abajo -->
  <div class="mt-8">
    <label class="mb-2 block text-sm font-medium text-(--color-text)">Generated classes</label>
    <div
      class="rounded-xl border border-(--color-border) bg-[#0d1117] p-4 font-mono text-sm text-gray-300 overflow-auto"
    >
      <code id="config-code" class="break-all">animate-fade-in</code>
    </div>
    <button
      type="button"
      id="config-copy"
      class="mt-3 w-full rounded-lg bg-(--color-primary) px-4 py-3 font-medium text-white hover:opacity-90 transition-opacity sm:w-auto sm:min-w-48"
    >
      Copy to clipboard
    </button>
  </div>
</div>

<script>
  (function () {
    const root = document.getElementById("configurator");
    if (!root) return;

    const selectAnimation = root.querySelector<HTMLSelectElement>("#config-animation");
    const selectDuration = root.querySelector<HTMLSelectElement>("#config-duration");
    const selectDelay = root.querySelector<HTMLSelectElement>("#config-delay");
    const checkboxScroll = root.querySelector<HTMLInputElement>("#config-scroll");
    const rangeWrap = root.querySelector<HTMLElement>("#config-range-wrap");
    const selectRange = root.querySelector<HTMLSelectElement>("#config-range");
    const previewBox = root.querySelector<HTMLElement>("#config-preview-box");
    const codeEl = root.querySelector<HTMLElement>("#config-code");
    const btnCopy = root.querySelector<HTMLButtonElement>("#config-copy");
    const btnReplay = root.querySelector<HTMLButtonElement>("#config-replay");

    if (
      !selectAnimation ||
      !selectDuration ||
      !selectDelay ||
      !checkboxScroll ||
      !rangeWrap ||
      !selectRange ||
      !previewBox ||
      !codeEl ||
      !btnCopy ||
      !btnReplay
    ) {
      return;
    }

    const baseBoxClasses =
      "h-24 w-24 rounded-xl bg-linear-to-br from-(--color-primary) to-indigo-600 font-semibold text-white shadow-lg flex items-center justify-center text-sm";

    function getRangeClass(value: string) {
      return value ? `animate-range-${value}` : "";
    }

    function buildClasses() {
      const anim = selectAnimation?.value ?? "";
      const duration = selectDuration?.value ?? "";
      const delay = selectDelay?.value ?? "";
      const useScroll = checkboxScroll?.checked ?? false;
      const range = selectRange?.value ?? "";

      const parts = [anim];
      if (duration) parts.push(duration);
      if (delay) parts.push(delay);
      if (useScroll) {
        parts.unshift("timeline-view");
        const rangeClass = getRangeClass(range);
        if (rangeClass) parts.push(rangeClass);
      }
      return parts.filter(Boolean).join(" ");
    }

    function updatePreview() {
      const classes = buildClasses();
      if (previewBox) {
        previewBox.className = baseBoxClasses + " " + classes;
      }
      if (codeEl) codeEl.textContent = classes;
    }

    function toggleRangeVisibility() {
      if (checkboxScroll?.checked) {
        rangeWrap?.classList.remove("hidden");
        btnReplay?.classList.add("hidden");
      } else {
        rangeWrap?.classList.add("hidden");
        btnReplay?.classList.remove("hidden");
      }
      updatePreview();
    }

    selectAnimation.addEventListener("change", updatePreview);
    selectDuration.addEventListener("change", updatePreview);
    selectDelay.addEventListener("change", updatePreview);
    selectRange.addEventListener("change", updatePreview);
    checkboxScroll.addEventListener("change", toggleRangeVisibility);

    btnReplay.addEventListener("click", () => {
      const box = root.querySelector<HTMLElement>("#config-preview-box");
      if (!box) return;
      const fullClasses = baseBoxClasses + " " + buildClasses();
      box.className = baseBoxClasses;
      void box.offsetHeight;
      box.className = fullClasses;
    });

    btnCopy.addEventListener("click", () => {
      const text = buildClasses();
      navigator.clipboard.writeText(text).then(() => {
        const orig = btnCopy.textContent;
        btnCopy.textContent = "Copied!";
        setTimeout(() => {
          btnCopy.textContent = orig;
        }, 2000);
      });
    });

    toggleRangeVisibility();
  })();
</script>
