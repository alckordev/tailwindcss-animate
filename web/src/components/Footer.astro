---

---

<footer class="border-t border-[var(--color-border)] py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-4">
      <div class="col-span-1 md:col-span-2">
        <div class="mb-4 flex items-center gap-3">
          <span class="text-3xl">✨</span>
          <h3
            class="text-xl font-bold bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent"
          >
            Tailwind CSS Animate
          </h3>
        </div>
        <p class="mb-6 max-w-md text-sm leading-relaxed text-[var(--color-text-muted)]">
          Extended animation utilities for Tailwind CSS v4 and v3. 85+ animations, scroll timelines,
          and view animations with zero configuration.
        </p>
        <div class="flex items-center gap-4">
          <a
            href="https://github.com/iscodex/tailwindcss-animate"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
            aria-label="GitHub"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
          <a
            href="https://twitter.com/alckordev"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
            aria-label="Twitter"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wide text-[var(--color-text)]">
          Documentation
        </h4>
        <ul class="space-y-3 text-sm text-[var(--color-text-muted)]">
          <li>
            <a href="/#installation" class="hover:text-[var(--color-text)] transition-colors">
              Installation
            </a>
          </li>
          <li>
            <a href="/#animations" class="hover:text-[var(--color-text)] transition-colors">
              Animation Collection
            </a>
          </li>
          <li>
            <a href="/#scroll" class="hover:text-[var(--color-text)] transition-colors">
              Scroll Animations
            </a>
          </li>
          <li>
            <a href="/configurator" class="hover:text-[var(--color-text)] transition-colors">
              Configurator
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wide text-[var(--color-text)]">
          Links
        </h4>
        <ul class="space-y-3 text-sm text-[var(--color-text-muted)]">
          <li>
            <a
              href="https://github.com/iscodex/tailwindcss-animate"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[var(--color-text)] transition-colors"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://www.npmjs.com/package/@iscodex/tailwindcss-animate"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[var(--color-text)] transition-colors"
            >
              npm Package (v4)
            </a>
          </li>
          <li>
            <a
              href="https://www.npmjs.com/package/@iscodex/tailwindcss-animate-plugin"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[var(--color-text)] transition-colors"
            >
              npm Package (v3)
            </a>
          </li>
          <li>
            <a
              href="https://github.com/iscodex/tailwindcss-animate/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[var(--color-text)] transition-colors"
            >
              Report an Issue
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-[var(--color-border)] pt-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-[var(--color-text-muted)]">
          Created with ❤️ by <a
            href="https://github.com/alckordev"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-primary)] hover:underline font-medium">alckordev</a
          >
        </p>
        <p class="text-sm text-[var(--color-text-muted)]">
          © 2026 Tailwind CSS Animate • MIT License
        </p>
      </div>
    </div>
  </div>
</footer>
