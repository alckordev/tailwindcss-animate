---
import { animations } from "../data/animations";

const durations = [
  { value: "100", label: "100ms" },
  { value: "200", label: "200ms" },
  { value: "300", label: "300ms" },
  { value: "500", label: "500ms" },
  { value: "700", label: "700ms" },
  { value: "1000", label: "1s" },
  { value: "2000", label: "2s" },
  { value: "3000", label: "3s" },
];

const delays = [
  { value: "", label: "none" },
  { value: "100", label: "100ms" },
  { value: "200", label: "200ms" },
  { value: "300", label: "300ms" },
  { value: "500", label: "500ms" },
  { value: "1000", label: "1s" },
];
---

<div data-animation-grid>
  <!-- Controls -->
  <div
    class="mb-8 rounded-xl border border-(--color-border) bg-(--color-bg) p-6 animate-fade-in-up animate-delay-600"
  >
    <div class="flex flex-wrap items-center gap-6">
      <!-- Duration -->
      <div class="flex items-center gap-3">
        <label class="text-sm font-medium text-(--color-text)">Duration</label>
        <select
          id="duration-select"
          class="rounded-md border border-(--color-border) bg-(--color-bg-alt) px-3 py-1.5 text-sm text-(--color-text)"
        >
          {
            durations.map((d) => (
              <option value={d.value} selected={d.value === "1000"}>
                {d.label}
              </option>
            ))
          }
        </select>
      </div>

      <!-- Delay -->
      <div class="flex items-center gap-3">
        <label class="text-sm font-medium text-(--color-text)">Delay</label>
        <select
          id="delay-select"
          class="rounded-md border border-(--color-border) bg-(--color-bg-alt) px-3 py-1.5 text-sm text-(--color-text)"
        >
          {delays.map((d) => <option value={d.value}>{d.label}</option>)}
        </select>
      </div>

      <!-- Infinite Loop Toggle -->
      <button
        id="infinite-toggle"
        class="ml-auto flex items-center gap-2 rounded-md border border-(--color-border) bg-(--color-bg-alt) px-4 py-2 text-sm font-medium text-(--color-text) hover:border-(--color-primary) transition-colors"
        data-active="false"
      >
        <svg
          id="infinite-icon"
          class="h-4 w-4 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
          ></path>
        </svg>
        <span>Infinite</span>
      </button>
    </div>
  </div>

  <!-- Animation Grid -->
  <div id="animation-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {
      animations.map((anim, index) => {
        const animationDelay = index < 12 ? 1000 + index * 50 : (index - 12) * 50;

        return (
          <div
            class:list={[
              "group relative overflow-hidden rounded-xl border border-(--color-border) bg-(--color-bg) p-6 transition-all hover:border-(--color-primary) hover:shadow-xl animate-fade-in-up",
              { hidden: index >= 12 },
            ]}
            data-animation-card
            data-animation-key={anim.class}
            data-index={index}
            style={`animation-delay: ${animationDelay}ms; animation-fill-mode: both;`}
          >
            {anim.description && (
              <span class="absolute right-2 top-2 rounded-md bg-linear-to-r from-blue-500 to-purple-500 px-2 py-1 text-xs font-bold text-white">
                {anim.description}
              </span>
            )}

            <div class="mb-4 flex h-32 items-center justify-center">
              <div class="animate-box h-20 w-20 rounded-xl bg-linear-to-br from-blue-500 via-purple-500 to-pink-500" />
            </div>

            <div class="space-y-2">
              <h3 class="font-mono text-sm font-semibold text-(--color-text)">{anim.name}</h3>
              <code class="block rounded-md bg-(--color-bg-alt) py-1.5 text-xs text-(--color-text-muted) font-mono">
                {anim.class}
              </code>
            </div>

            <button
              class="copy-btn mt-4 w-full rounded-md bg-(--color-primary) px-3 py-2 text-sm font-medium text-white opacity-0 transition-all group-hover:opacity-100 hover:bg-(--color-primary-hover) hover:cursor-pointer"
              data-copy={anim.class}
            >
              Copy
            </button>
          </div>
        );
      })
    }
  </div>

  <!-- View All Animations Button (Below Grid) -->
  <div class="mt-8 flex justify-center">
    <button
      id="view-all-btn"
      class="rounded-lg border-2 border-(--color-border) bg-transparent px-8 py-3 font-semibold text-(--color-text) hover:border-(--color-primary) hover:bg-(--color-primary)/10 transition-all"
    >
      View all animations ({animations.length})
    </button>
  </div>
</div>

<script is:inline>
  let duration = "1000";
  let delay = "";
  let showAll = false;
  let isInfinite = false;

  const applyAnimationSettings = () => {
    const allCards = document.querySelectorAll("[data-animation-card]");

    allCards.forEach((card) => {
      const animationKey = card.getAttribute("data-animation-key");
      const box = card.querySelector(".animate-box");

      if (!box || !animationKey) return;

      // If infinite mode is active, apply animation immediately
      if (isInfinite) {
        box.classList.add(animationKey);
        if (duration) box.style.animationDuration = `${duration}ms`;
        if (delay) box.style.animationDelay = `${delay}ms`;
        box.style.animationIterationCount = "infinite";
      } else {
        // Remove infinite animation if mode is off
        box.classList.remove(animationKey);
        box.style.animationDuration = "";
        box.style.animationDelay = "";
        box.style.animationIterationCount = "";
      }
    });
  };

  const setupHoverListeners = () => {
    const allCards = document.querySelectorAll("[data-animation-card]");

    allCards.forEach((card) => {
      const animationKey = card.getAttribute("data-animation-key");
      const box = card.querySelector(".animate-box");

      if (!box || !animationKey) return;

      // Mouse enter
      card.addEventListener("mouseenter", () => {
        if (isInfinite) return; // Skip hover if infinite is active

        box.classList.add(animationKey);
        if (duration) box.style.animationDuration = `${duration}ms`;
        if (delay) box.style.animationDelay = `${delay}ms`;
      });

      // Mouse leave
      card.addEventListener("mouseleave", () => {
        if (isInfinite) return; // Skip hover removal if infinite is active

        box.classList.remove(animationKey);
        box.style.animationDuration = "";
        box.style.animationDelay = "";
      });
    });
  };

  const setupCopyButtons = () => {
    const copyButtons = document.querySelectorAll(".copy-btn");
    copyButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget;
        const text = target.dataset.copy || "";
        navigator.clipboard.writeText(text);
        const original = target.textContent;
        target.textContent = "Copied!";
        setTimeout(() => {
          target.textContent = original;
        }, 2000);
      });
    });
  };

  const toggleViewAll = () => {
    showAll = !showAll;
    const allCards = document.querySelectorAll("[data-animation-card]");
    const viewAllBtn = document.getElementById("view-all-btn");

    allCards.forEach((card, index) => {
      if (showAll) {
        // Show all cards and re-trigger animation for hidden ones
        if (index >= 12) {
          // Force animation restart
          card.classList.remove("animate-fade-in-up");
          void card.offsetWidth; // Force reflow
          card.classList.add("animate-fade-in-up");
        }
        card.classList.remove("hidden");
      } else {
        if (index >= 12) {
          card.classList.add("hidden");
        }
      }
    });

    // Update button text
    if (viewAllBtn) {
      viewAllBtn.textContent = showAll ? "Show less" : `View all animations (${allCards.length})`;
    }
  };

  // Duration change
  const durationSelect = document.getElementById("duration-select");
  durationSelect?.addEventListener("change", (e) => {
    duration = e.target.value;
    applyAnimationSettings();
  });

  // Delay change
  const delaySelect = document.getElementById("delay-select");
  delaySelect?.addEventListener("change", (e) => {
    delay = e.target.value;
    applyAnimationSettings();
  });

  // Infinite toggle
  const infiniteToggle = document.getElementById("infinite-toggle");
  const infiniteIcon = document.getElementById("infinite-icon");
  infiniteToggle?.addEventListener("click", () => {
    isInfinite = !isInfinite;
    infiniteToggle.setAttribute("data-active", isInfinite.toString());

    // Update button style and icon animation
    if (isInfinite) {
      infiniteToggle.classList.add(
        "bg-(--color-primary)",
        "text-white",
        "border-(--color-primary)"
      );
      infiniteToggle.classList.remove("bg-(--color-bg-alt)", "text-(--color-text)");
      infiniteIcon?.classList.add("animate-spin");
    } else {
      infiniteToggle.classList.remove(
        "bg-(--color-primary)",
        "text-white",
        "border-(--color-primary)"
      );
      infiniteToggle.classList.add("bg-(--color-bg-alt)", "text-(--color-text)");
      infiniteIcon?.classList.remove("animate-spin");
    }

    // Apply/remove infinite animations
    applyAnimationSettings();
  });

  // View all / Show less toggle
  const viewAllBtn = document.getElementById("view-all-btn");
  viewAllBtn?.addEventListener("click", () => {
    toggleViewAll();
  });

  // Initial setup
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setupHoverListeners();
      setupCopyButtons();
    });
  } else {
    setupHoverListeners();
    setupCopyButtons();
  }
</script>
